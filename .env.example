# RepoSleuth 环境配置模板
# 复制为 .env（.gitignore 已忽略 .env，不会被提交），填入真实 Key

# === LLM 配置 ===
# 模型名：glm-4-flash（智谱免费）/ deepseek-chat / qwen-plus ...
REPOSLEUTH_MODEL=glm-4-flash

# 智谱开放平台 Key：https://open.bigmodel.cn 注册即得（glm-4-flash 免费）
ZHIPUAI_API_KEY=

# 备用：换其他 provider 时取消注释
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# REPOSLEUTH_PROVIDER=
# REPOSLEUTH_BASE_URL=
